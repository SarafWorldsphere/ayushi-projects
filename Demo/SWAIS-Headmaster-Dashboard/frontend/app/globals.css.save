/* =========================================================
   DEMO HM DASHBOARD - GLOBAL STYLES
   Organized version
   Note: Existing screen style is preserved.
   ========================================================= */


/* =========================================================
   1. RESET & BASE STYLES
   ========================================================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Inter", sans-serif;
}

body {
  background: #0f172a; /* Dark navy background */
  color: #f8fafc; /* White text */
  min-height: 100vh;
  margin: 0;
}


/* =========================================================
   2. MAIN LAYOUT
   ========================================================= */

.layout {
  display: flex;
  min-height: 100vh;
}

.main-content {
  flex: 1;
  padding: 28px;
  overflow-y: auto;
  min-width: 0;
}


/* =========================================================
   3. SIDEBAR
   ========================================================= */

.sidebar {
  width: 270px;
  background: #111827; /* Darker navy for sidebar */
  border-right: 1px solid #1f2937;
  color: white;
  padding: 22px 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: sticky;
  top: 0;
  height: 100vh;
}

.brand-box {
  text-align: center;
  margin-bottom: 35px;
}

.logo-circle,
.brand-circle {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 0 auto 16px;
}

.school-logo,
.brand-logo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.brand-box h2 {
  font-size: 32px;
  font-weight: 800;
  margin-bottom: 5px;
}

.brand-box p {
  opacity: 0.8;
  font-size: 15px;
}


/* =========================================================
   4. SIDEBAR MENU & LOGOUT
   ========================================================= */

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.menu-btn {
  border: none;
  background: transparent;
  color: white;
  padding: 15px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  gap: 14px;
  cursor: pointer;
  transition: 0.3s;
  font-size: 16px;
  font-weight: 500;
}

.menu-btn:hover {
  background: rgba(255, 255, 255, 0.08);
}

.menu-btn.active {
  background: #2563eb;
}

.logout-btn {
  border: none;
  background: transparent;
  color: #ff4d4f;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  cursor: pointer;
  font-size: 16px;
}

/* =========================================================
   5. TOPBAR, SEARCH, PROFILE & NOTIFICATION
   Final version - neutral speaker + blue mic
   ========================================================= */

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
  gap: 20px;
  flex-wrap: wrap;
}

.topbar-left {
  flex: 1;
  min-width: 320px;
}

.search-box {
  background: #1f2937; /* Dark gray/blue */
  border: 1px solid #374151;
  padding: 0 18px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  max-width: 630px;
  min-height: 54px; /* Fixed height so it's not too huge */
}

.search-input {
  border: none;
  outline: none;
  width: 100%;
  background: transparent;
  font-size: 16px;
  color: #f8fafc; /* White text for typing */
  font-weight: 500;
}

.search-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f2937;
  flex-shrink: 0;
}

.search-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: auto;
  flex-shrink: 0;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.notification-bell {
  position: relative;
  width: 64px;
  height: 64px;
  border-radius: 18px;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f172a;
  cursor: pointer;
  border: 1px solid #edf1f7;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
}

.notification-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  min-width: 18px;
  height: 18px;
  background: #ef4444;
  color: #ffffff;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 5px;
}

.profile-card,
.profile-box {
  background: #1f2937; /* Dark card */
  border-radius: 18px;
  padding: 12px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 60px;
  border: 1px solid #374151;
}

.profile-card h3,
.profile-box h4 {
  font-size: 16px;
  font-weight: 700;
  line-height: 1.2;
}

.profile-card p,
.profile-box p {
  color: #9ca3af; /* Light gray text */
  font-size: 14px;
  margin-top: 2px;
}
/* =========================================================
   6. DASHBOARD KPI CARDS
   ========================================================= */

.analytics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
  margin-bottom: 28px;
}

.analytics-card {
  border-radius: 22px;
  padding: 26px;
  color: white;
  display: flex;
  gap: 18px;
  align-items: center;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
}

.analytics-card h2 {
  font-size: 38px;
  margin-bottom: 5px;
}

.analytics-card p {
  font-size: 15px;
}

.blue {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
}

.green {
  background: linear-gradient(135deg, #22c55e, #16a34a);
}

.purple {
  background: linear-gradient(135deg, #7c3aed, #6d28d9);
}

.orange {
  background: linear-gradient(135deg, #f59e0b, #ea580c);
}


/* =========================================================
   7. DASHBOARD CHARTS
   ========================================================= */

.charts-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 22px;
  margin-bottom: 28px;
}


/* =========================================================
   8. COMMON CARDS & PAGE HEADER
   ========================================================= */

.card,
.page-card {
  background: #1e293b; /* Changed from white */
  border-radius: 22px;
  padding: 24px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  overflow-x: hidden;
  border: 1px solid #334155;
  color: #f8fafc; /* Ensure text is white */
}

.card h3 {
  margin-bottom: 18px;
  font-size: 22px;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
}

.page-header h2 {
  font-size: 32px;
}


/* =========================================================
   9. TABLE STYLES
   ========================================================= */

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 700px;
}

.card,
.page-card {
  background: #1e293b; /* Changed from white */
  border-radius: 22px;
  padding: 24px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  overflow-x: hidden;
  border: 1px solid #334155;
  color: #f8fafc; /* Ensure text is white */
}
2. Update Section 9 (Table Styles)
Find 9. TABLE STYLES and update the table backgrounds, borders, and hover states so they aren't glaringly white:

CSS
thead {
  background: #334155; /* Dark header background */
}

th {
  text-align: left;
  padding: 14px;
  font-size: 13px;
  color: #cbd5e1; /* Light gray text */
}

td {
  padding: 14px;
  border-top: 1px solid #334155; /* Dark borders */
  font-size: 14px;
  color: #f8fafc; /* White text */
}

tbody tr:hover {
  background: #1f2937; /* Dark hover effect */
}

.clickable-row {
  cursor: pointer;
}

.clickable-row:hover {
  background: #374151;
}


/* =========================================================
   10. STATUS BADGES
   ========================================================= */

.status {
  padding: 6px 14px;
  border-radius: 18px;
  font-size: 12px;
  font-weight: 700;
}

.status.active {
  background: #dcfce7;
  color: #15803d;
}

.status.inactive {
  background: #fee2e2;
  color: #dc2626;
}


/* =========================================================
   11. STUDENT CARDS
   ========================================================= */

.student-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

.student-card {
  border: 1px solid #334155;
  border-radius: 20px;
  padding: 22px;
  transition: 0.3s;
  background: #1e293b; /* Dark card background */
  color: #f8fafc;
}

.student-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.student-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18px;
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #2563eb;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 700;
}

.student-card h3 {
  margin-bottom: 8px;
}

.student-card p {
  color: #94a3b8;
}

.student-info {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #475569;
  margin-bottom: 10px;
  font-size: 14px;
}


/* =========================================================
   12. STUDENT SECTION TABS
   ========================================================= */

.student-section-tabs {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}



.student-section-tabs button:hover {
  background: #f8fafc;
  color: #2563eb;
  transform: translateY(-1px);
}

.active-student-tab {
  background: #2563eb !important;
  color: #ffffff !important;
  border-color: #2563eb !important;
  box-shadow: 0 6px 14px rgba(37, 99, 235, 0.25);
}


/* =========================================================
   13. PROGRESS SCREEN - COMMON
   ========================================================= */

.progress-subtitle {
  margin: 18px 0;
  color: #0f172a;
}

.progress-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 22px;
  color: #64748b;
  font-weight: 600;
}

.progress-breadcrumb button {
  border: none;
  background: transparent;
  color: #2563eb;
  cursor: pointer;
  font-weight: 700;
}


/* =========================================================
   14. PROGRESS SCREEN - CLASS CARDS
   ========================================================= */

.progress-class-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.progress-class-card {
  padding: 28px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  border-radius: 20px;
  font-size: 20px;
  font-weight: 800;
  color: #0f172a;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
}

.progress-class-card:hover {
  color: #2563eb;
  transform: translateY(-2px);
}

.progress-class-name {
  font-size: 22px;
  font-weight: 800;
  margin-bottom: 8px;
}

.progress-class-count {
  font-size: 14px;
  font-weight: 600;
  opacity: 0.9;
}

.progress-class-card.active-progress-class-card {
  background: linear-gradient(135deg, #2563eb, #1d4ed8) !important;
  color: #ffffff !important;
  border-color: #2563eb !important;
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.28);
}

.progress-class-card.active-progress-class-card:hover {
  color: #ffffff !important;
}

.progress-class-card.active-progress-class-card .progress-class-name,
.progress-class-card.active-progress-class-card .progress-class-count {
  color: #ffffff !important;
}

button.progress-class-card.active-progress-class-card {
  background: #2563eb !important;
  color: #ffffff !important;
  border: 1px solid #2563eb !important;
}

button.progress-class-card.active-progress-class-card .progress-class-name,
button.progress-class-card.active-progress-class-card .progress-class-count {
  color: #ffffff !important;
}


/* =========================================================
   15. PROGRESS SCREEN - STUDENT CARDS
   ========================================================= */

.progress-student-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
}

.progress-student-card-small {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 20px;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
}

.progress-student-card-small h3 {
  margin: 0 0 6px;
  font-size: 19px;
  color: #0f172a;
}

.progress-student-card-small p {
  margin: 0;
  color: #64748b;
}

.progress-student-card-small button,
.progress-back-btn {
  padding: 10px 16px;
  border: none;
  border-radius: 12px;
  background: #2563eb;
  color: white;
  font-weight: 700;
  cursor: pointer;
}

.progress-back-btn {
  margin-bottom: 18px;
}


/* =========================================================
   16. PROGRESS SCREEN - SUMMARY & TABLE
   ========================================================= */

.progress-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin: 20px 0;
}

.progress-summary-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 18px;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
}

.progress-summary-card span {
  display: block;
  color: #64748b;
  font-size: 13px;
  margin-bottom: 8px;
}

.progress-summary-card strong {
  font-size: 18px;
  color: #0f172a;
}

.progress-table-scroll {
  width: 100%;
  overflow-x: auto;
}

.progress-table-scroll table {
  width: 100%;
  min-width: 700px;
}


/* =========================================================
   17. BOTTOM GRID, ERROR & LOADING STATES
   ========================================================= */

.bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}

.error-banner {
  background: #fee2e2;
  color: #991b1b;
  border: 1px solid #fecaca;
  border-radius: 10px;
  padding: 12px 16px;
  margin-bottom: 16px;
  font-weight: 600;
}

.loading-text {
  background: white;
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 16px;
  color: #475569;
}


/* =========================================================
   18. RESPONSIVE STYLES
   ========================================================= */

@media (max-width: 1400px) {
  .analytics-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .charts-grid {
    grid-template-columns: 1fr;
  }

  .student-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    height: auto;
    position: relative;
  }
.topbar {
  flex-direction: column;
  align-items: stretch;
}

.topbar-right {
  justify-content: flex-end;
  flex-wrap: wrap;
}

.analytics-grid,
.bottom-grid,
.student-grid {
  grid-template-columns: 1fr;
}

.search-box {
  width: 100%;
  max-width: 100%;
  min-height: 72px;
  border-radius: 18px;
  padding: 0 14px;
}

.search-input {
  font-size: 15px;
}

.speak-btn,
.mic-btn {
  width: 40px;
  height: 40px;
}

  .progress-summary-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .progress-summary-grid {
    grid-template-columns: 1fr;
  }

  .progress-student-card-small {
    flex-direction: column;
    align-items: flex-start;
  }
}


.logout-style {
  color: red;
}

.logout-style:hover {
  background: rgba(255, 0, 0, 0.08);
}
.logout-wrapper {
  margin-top: auto;
  padding: 16px;
}

.logout-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #fff;
  color: red;
  border: none;
  cursor: pointer;
  font-weight: 600;
}

/* Logout Modal */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.modal-box {
  width: 420px;
  background: #fff;
  border-radius: 18px;
  padding: 28px;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 30px;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12px;
}

.modal-text {
  font-size: 16px;
  color: #64748b;
  margin-bottom: 24px;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

.modal-cancel-btn {
  padding: 10px 18px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  background: #fff;
  cursor: pointer;
  font-weight: 600;
}

.modal-cancel-btn:hover {
  background: #f3f4f6;
}

.modal-logout-btn {
  padding: 10px 18px;
  border: none;
  border-radius: 10px;
  background: #dc2626;
  color: white;
  cursor: pointer;
  font-weight: 600;
}

.modal-logout-btn:hover {
  background: #b91c1c;
}
/* =========================================================
   TOPBAR - SPEAKER & MIC BUTTONS
   Final version - neutral speaker + blue mic
   ========================================================= */

.speak-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.speak-btn:hover {
  transform: translateY(-1px) scale(1.03);
  background: #f8fafc;
  color: #0f172a;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
}

.speak-btn:active {
  transform: scale(0.97);
}

.mic-btn {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  border: none;
  background: linear-gradient(135deg, #1d4ed8, #1e3a8a);
  color: #ffffff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 18px rgba(29, 78, 216, 0.28);
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.mic-btn:hover {
  transform: translateY(-1px) scale(1.03);
  box-shadow: 0 10px 22px rgba(29, 78, 216, 0.35);
}

.mic-btn:active {
  transform: scale(0.97);
}

.mic-btn.active {
  animation: pulseMic 1s infinite;
  box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.12);
}

@keyframes pulseMic {
  0% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.35);
  }
  70% {
    transform: scale(1.06);
    box-shadow: 0 0 0 12px rgba(37, 99, 235, 0);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
  }
}
/* ===========================
   Language Button
=========================== */

.language-wrapper {
  position: relative;
  margin-right: 14px;
}

.language-btn {
  display: flex;
  align-items: center;
  gap: 8px;

  min-width: 140px;
  height: 42px;
  padding: 0 16px;

  border: 1px solid rgba(255,255,255,.2);
  border-radius: 999px;

  background: linear-gradient(135deg,#2563eb,#4f46e5);
  color: #fff;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition: all .25s ease;
  box-shadow: 0 8px 22px rgba(37,99,235,.25);
}

.language-btn span{
  flex:1;
  text-align:left;
}

.language-btn:hover{
  transform: translateY(-2px);
  box-shadow:0 14px 30px rgba(37,99,235,.35);
}

.language-btn:active{
  transform:scale(.98);
}

.rotate{
  transform:rotate(180deg);
  transition:.25s;
}

/* ===========================
   Dropdown
=========================== */

.language-dropdown{
  position:absolute;
  top:52px;
  right:0;

  width:220px;

  background:#fff;

  border-radius:18px;

  border:1px solid #e5e7eb;

  box-shadow:
      0 10px 30px rgba(0,0,0,.12);

  overflow:hidden;

  animation:popup .18s ease;

  z-index:9999;
}

.language-item{
  width:100%;

  display:flex;
  justify-content:space-between;
  align-items:center;

  padding:14px 18px;

  border:none;
  background:#fff;

  cursor:pointer;

  font-size:15px;
  font-weight:500;

  transition:.2s;
}

.language-item:hover{
  background:#f3f4f6;
}

.language-item.selected{
  background:#eff6ff;
  color:#2563eb;
  font-weight:600;
}

/* Divider */

.language-item:not(:last-child){
  border-bottom:1px solid #f1f5f9;
}

/* Animation */

@keyframes popup{
  from{
    opacity:0;
    transform:translateY(-8px) scale(.96);
  }
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}
