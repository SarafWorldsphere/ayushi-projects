# Copy to .env.local and fill in. NEVER commit .env.local.
# Remember: NEXT_PUBLIC_* values are baked in at BUILD time -> rebuild after changing.

# Role prefix this app is served under behind Nginx (see Port Registry / Nginx standard)
NEXT_PUBLIC_BASE_PATH=/parent

# Base URL for all API calls (goes through lib/api.js)
# Staging example: https://staging.sgs.swais.in/api/parent
# Local dev example: http://localhost:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Port this frontend listens on (must match the Port Registry and ecosystem.config.js)
PORT=3009
