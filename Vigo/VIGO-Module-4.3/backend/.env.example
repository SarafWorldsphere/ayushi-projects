# Copy to .env and fill in. NEVER commit .env.
APP_NAME=vigo-customer-backend

# Port from the Port Registry (8000-range for backends)
# Standardized to 8000 to fix Error C11 and C12 port mismatches
PORT=8000

# FULL connection string - never hardcode this in code, never log it
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated allowed origins
CORS_ORIGINS=https://staging.sgs.swais.in,http://localhost:3000

# JWT Authentication Secrets
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440