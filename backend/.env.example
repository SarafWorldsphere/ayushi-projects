# Copy to .env and fill in. NEVER commit .env.
APP_NAME=CHANGE-ME-project-role-backend
# Port from the Port Registry (8000-range for backends)
PORT=8001
# Full connection string — never hardcode this in code, never log it
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Comma-separated allowed origins
CORS_ORIGINS=https://staging.sgs.swais.in,http://localhost:3000
